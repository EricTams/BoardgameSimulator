# Local development automatically uses the bundled WebSocket relay.
# GitHub Pages uses PeerJS/WebRTC unless VITE_RELAY_URL is set at build time.
# VITE_RELAY_URL=wss://your-server.example/rooms

# For `npm run build && npm start`, enable the same-origin relay when building:
# VITE_TRANSPORT=relay

# Optional TURN configuration for WebRTC on restrictive networks.
# These are embedded in the browser bundle: use limited-scope credentials.
# VITE_TURN_URLS=turn:your-turn-server.example:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
